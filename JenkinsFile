pipeline {
    agent any

    environment {
        GITHUB_CREDENTIALS = credentials('github-credentials')  // Uses GitHub credentials from Jenkins
    }

    stages {
        stage('Fetch Upcoming Branch') {
            steps {
                script {
                    def upcomingBranch = bat(script: '''
                        git ls-remote --heads https://github.com/SahilBirwadkar/FreelancingDemo.git | 
                        awk -F'/' '/upcoming/ {print $3}' | head -n 1
                    ''', returnStdout: true).trim()
                    
                    echo "Fetched upcoming branch: ${upcomingBranch}"
                    env.UPCOMING_BRANCH = upcomingBranch
                }
            }
        }

        stage('Checkout and Merge Develop') {
            steps {
                script {
                    bat """
                        git checkout ${env.UPCOMING_BRANCH}
                        git pull origin ${env.UPCOMING_BRANCH}
                        git merge origin/develop || echo "Merge conflict detected"
                    """
                }
            }
        }

        stage('Handle Merge Conflicts') {
            steps {
                script {
                    def mergeStatus = bat(script: "git status --porcelain | grep '^U' | wc -l", returnStdout: true).trim()
                    
                    if (mergeStatus != "0") {
                        echo "Merge conflict detected. Creating PR..."
                        bat """
                            curl -u "$GITHUB_CREDENTIALS" -X POST \
                                -H "Accept: application/vnd.github.v3+json" \
                                -H "Authorization: token $GITHUB_CREDENTIALS" \
                                -d '{
                                    "title": "Resolve Merge Conflict: ${env.UPCOMING_BRANCH}",
                                    "head": "${env.UPCOMING_BRANCH}",
                                    "base": "develop",
                                    "body": "This PR resolves merge conflicts between ${env.UPCOMING_BRANCH} and develop."
                                }' \
                                "https://api.github.com/repos/SahilBirwadkar/FreelancingDemo/pulls"
                        """
                    }
                }
            }
        }

        stage('Build & Deploy') {
            steps {
                script {
                    echo "Building and deploying ${env.UPCOMING_BRANCH}"
                    bat "./gradlew build"
                }
            }
        }
    }
}

